# Copie este arquivo para ".env" (no Windows: copy .env.example .env) e preencha.
# NUNCA suba o ".env" no GitHub e NUNCA mande o token por WhatsApp ou cole em chat.
# O token e so seu: quem tem o token mexe no seu dinheiro de anuncio.

# Token PERMANENTE de Usuario do Sistema (README, passo 3).
# Permissoes: ads_management, ads_read, business_management, pages_show_list, pages_read_engagement
META_ADS_TOKEN=COLE_AQUI_O_SEU_TOKEN

# Sua conta de anuncio. Formato: act_1234567890   (python meta_ads.py contas)
META_AD_ACCOUNT=act_000000000000

# ID da Pagina do Facebook do escritorio   (python meta_ads.py paginas)
META_PAGE_ID=

# Opcional: ID do Instagram profissional ligado a pagina (aparece em "paginas")
META_INSTAGRAM_ID=

# WhatsApp que recebe os leads, com DDI e DDD. Precisa estar CONECTADO a Pagina.
META_WHATSAPP_NUMERO=+5511999999999

# Trava de seguranca: soma maxima de orcamento DIARIO que o script aceita criar, em reais.
MAX_ORCAMENTO_DIARIO=100
